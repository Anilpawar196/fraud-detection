# Reports are entirely regenerated by scripts/ — audit JSON, drift tables, SHAP
# importances, figures and run logs. They are outputs, not source, and some are
# hundreds of KB. reports/README.md documents how to reproduce each one.
reports/*
!reports/README.md

# Secrets — .env.example is the committed template and carries no real values.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
credentials.json
secrets.yaml
kaggle.json
.kaggle/

