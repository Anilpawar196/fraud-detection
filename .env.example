# Copy to .env and adjust. .env is gitignored and must never be committed.
#
# Every key maps to a field on api.settings.Settings (pydantic-settings matches
# case-insensitively). Keys the code does not read are deliberately absent.

LOG_LEVEL=INFO

# Model loading
MODEL_ARTIFACT_PATH=models/model_artifact.pkl
MODEL_VERSION=1

# Risk banding: business configuration, not a model constant.
RISK_THRESHOLD_MEDIUM=0.30
RISK_THRESHOLD_HIGH=0.70

# Optional: point MLflow at a tracking server. Unset -> local ./mlruns file store,
# which is all this project needs.
# MLFLOW_TRACKING_URI=http://localhost:5000
